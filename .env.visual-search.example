# Visual Search Configuration
# Copier ce fichier en .env et remplir vos valeurs

# ===== CLARIFAI API =====
# Obtenir une clé API: https://clarifai.com/settings/applications
CLARIFAI_API_KEY=votre_clé_api_clarifai_ici

# URL API Clarifai (généraliste - reconnaissance d'objets)
CLARIFAI_API_URL=https://api.clarifai.com/v2/models/aaa03c23b3724a16a56b629203edc62c/outputs
